# .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# Full SQLAlchemy connection string used by the backend app.
# Host is "postgres" (the docker-compose service name) when running via Docker Compose,
# or "localhost" when running the backend directly against a local Postgres instance.
DATABASE_URL=postgresql://hsp_user:hsp_password@postgres:5432/hsp

# Individual pieces used by the "postgres" service in docker-compose.yml.
# Keep these in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=hsp_user
POSTGRES_PASSWORD=hsp_password
POSTGRES_DB=hsp

# --- Auth ---
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (post-MVP notifications) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
