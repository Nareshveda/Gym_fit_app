# .gitignore

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Node ---
node_modules/
dist/
dist-ssr/
*.local
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.vite/

# --- Environment ---
.env
.env.local
.env.*.local
!.env.example

# --- Local databases ---
*.db
*.sqlite
*.sqlite3

# --- User-uploaded files (equipment documents, profile avatars) ---
# Recreated automatically on startup (see app.main); never part of the repo.
backend/uploads/

# --- Docker ---
*.pid

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
